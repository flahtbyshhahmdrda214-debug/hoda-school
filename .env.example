# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://hoda_user:hoda_password@localhost:5432/hoda_db?schema=public

# Authentication & Security Secrets (Generate 64-character random hex strings in production)
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_hex_string
COOKIE_SECRET=replace_with_64_character_cryptographically_secure_random_hex_string
JWT_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000/uploads

# Security & Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000
